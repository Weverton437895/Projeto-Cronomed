# Copie para .env (que NAO deve ser versionado) e ajuste os valores.
DB_NAME=cronomed
DB_USER=cronomed
DB_PASSWORD=troque-esta-senha

# Chave HMAC do JWT: minimo 32 caracteres. Gere com:  openssl rand -base64 48
JWT_SECRET=

SPRING_PROFILES_ACTIVE=dev
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Usuario da API no broker MQTT (a senha tambem e usada por scripts/setup-mosquitto.sh)
MQTT_API_USER=cronomed-api
MQTT_API_PASSWORD=troque-esta-senha-mqtt
