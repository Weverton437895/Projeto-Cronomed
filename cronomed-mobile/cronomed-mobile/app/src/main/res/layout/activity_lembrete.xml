<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/tvContagemLembrete"
                style="@style/Selo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lembrete_pill"
                android:textColor="@color/branco" />

            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/branco"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hora_do_remedio"
                android:textColor="@color/creme"
                android:textSize="18sp" />

            <br.com.cronomed.ui.CompartimentoIconView
                android:id="@+id/ivCompartimento"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/branco"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/creme"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvInstrucoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_lembrete_nota"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVoz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/creme"
                android:textSize="15sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTomei"
                style="@style/Botao.Branco"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/ja_tomei"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDepois"
                style="@style/Botao.ContornoBranco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lembrar_depois" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoz"
                style="@style/Botao.ContornoBranco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/responder_por_voz"
                app:icon="@drawable/ic_mic"
                app:iconGravity="textStart"
                app:iconTint="@color/branco" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_carregando" />
</FrameLayout>
