<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margem_tela"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/margem_tela"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_logo_mark" />

    <TextView
        android:id="@+id/tvTopoTitulo"
        style="@style/Texto.Titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textSize="22sp" />

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_botao_menu"
        android:contentDescription="@string/abrir_menu"
        android:src="@drawable/ic_menu"
        app:tint="@color/azul"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
