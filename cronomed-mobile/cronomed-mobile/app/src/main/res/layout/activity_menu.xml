<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fundoMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_painel_menu"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_painel_topo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvIniciais"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/azul"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomeMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/branco"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmailMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/creme"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFechar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fechar"
                android:src="@drawable/ic_close"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:tint="@color/branco" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/itemCadastro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="16dp"
                android:drawableTint="@color/preto"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_cadastro"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemCompartilhamento"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_users"
                android:drawablePadding="16dp"
                android:drawableTint="@color/preto"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_compartilhamento"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemDispositivos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_box"
                android:drawablePadding="16dp"
                android:drawableTint="@color/preto"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_dispositivos"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemSeguranca"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_shield"
                android:drawablePadding="16dp"
                android:drawableTint="@color/preto"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_seguranca"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemConfiguracoes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_sliders"
                android:drawablePadding="16dp"
                android:drawableTint="@color/preto"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_configuracoes"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemSair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_logout"
                android:drawablePadding="16dp"
                android:drawableTint="@color/perigo"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/menu_sair"
                android:textColor="@color/perigo"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
