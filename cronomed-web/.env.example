# Copie para .env se precisar mudar algo (nenhum valor e secreto aqui; sao so enderecos).

# Para onde o servidor de desenvolvimento (npm run dev) encaminha as chamadas /api
VITE_API_PROXY=http://localhost:8080

# Base da API usada pelo navegador. Deixe /api/v1 para usar o proxy do Vite (dev) ou do nginx (Docker).
# So mude se a API estiver em outro dominio (nesse caso, inclua a origem do site em CORS_ALLOWED_ORIGINS no backend).
# VITE_API_BASE=https://api.seudominio.com.br/api/v1
